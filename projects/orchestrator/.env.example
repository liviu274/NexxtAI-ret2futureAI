# Copy to .env and fill in. Loaded with: uvicorn nexxt_orchestrator.api:app --env-file .env
# Without the key, uploads are refused (503): nothing could read them.
FEATHERLESS_API_KEY=

# Analysts and their tokens. Unset = dev mode: the X-Analyst header is trusted as the analyst's name.
# NEXXT_ANALYSTS=Maria Ionescu=change-me-1,Elena Radu=change-me-2

# Demo only: accept the synthetic SPECIMEN identity sheets of the dataset at the portal's ID step.
# NEXXT_ACCEPT_SPECIMEN=1

# Optional (defaults shown)
# NEXXT_CORS_ORIGINS=http://localhost:8080,http://localhost:5173,http://localhost:3000
# FEATHERLESS_BASE_URL=https://api.featherless.ai/v1
# FEATHERLESS_OCR_MODEL=Qwen/Qwen3-VL-8B-Instruct
# FEATHERLESS_EXTRACTION_MODEL=Qwen/Qwen3-VL-8B-Instruct
